generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
}

model bookings {
  id              Int        @id @default(autoincrement())
  user_id         Int
  trips_id        Int
  travel_date     DateTime   @db.Date
  travelers_count Int
  total_price     Decimal    @db.Decimal(10, 2)
  status          String     @db.VarChar(50)
  created_at      DateTime   @db.DateTime(0)
  users           users      @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "bookings_ibfk_1")
  trips           trips      @relation(fields: [trips_id], references: [id], onUpdate: Restrict, map: "bookings_ibfk_2")
  payments        payments[]

  @@index([trips_id], map: "trips_id")
  @@index([user_id], map: "user_id")
}

model contact_messages {
  id           Int      @id @default(autoincrement())
  message_name String   @db.VarChar(255)
  email        String   @db.VarChar(255)
  subject      String   @db.VarChar(255)
  created_at   DateTime @db.DateTime(0)
}

model countries {
  id     Int     @id @default(autoincrement())
  cname  String  @unique(map: "cname") @db.VarChar(255)
  cimage String? @db.VarChar(255)
}

model flights {
  id       Int    @id @default(autoincrement())
  airline  String @db.VarChar(255)
  duration Int
  uses     uses[]
}

model hotels {
  id         Int        @id @default(autoincrement())
  hotel_name String     @db.VarChar(255)
  stars      Int
  includes   includes[]
}

model includes {
  id        Int    @id @default(autoincrement())
  trips_id  Int
  hotels_id Int
  trips     trips  @relation(fields: [trips_id], references: [id], onUpdate: Restrict, map: "includes_ibfk_1")
  hotels    hotels @relation(fields: [hotels_id], references: [id], onUpdate: Restrict, map: "includes_ibfk_2")

  @@index([hotels_id], map: "hotels_id")
  @@index([trips_id], map: "trips_id")
}

model payments {
  id             Int      @id @default(autoincrement())
  bookings_id    Int
  amount         Decimal  @db.Decimal(10, 2)
  payment_method String   @db.VarChar(50)
  payment_status String   @db.VarChar(50)
  created_at     DateTime @db.DateTime(0)
  bookings       bookings @relation(fields: [bookings_id], references: [id], onUpdate: Restrict, map: "payments_ibfk_1")

  @@index([bookings_id], map: "bookings_id")
}

model review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  trips_id   Int
  rating     Int
  comment    String?  @db.Text
  created_at DateTime @db.DateTime(0)
  users      users    @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "review_ibfk_1")
  trips      trips    @relation(fields: [trips_id], references: [id], onUpdate: Restrict, map: "review_ibfk_2")

  @@index([trips_id], map: "trips_id")
  @@index([user_id], map: "user_id")
}

model travel_types {
  id    Int    @id @default(autoincrement())
  tname String @unique(map: "tname") @db.VarChar(255)
}

model trip_dates {
  id             Int      @id @default(autoincrement())
  trips_id       Int
  available_date DateTime @db.Date
  trips          trips    @relation(fields: [trips_id], references: [id], onUpdate: Restrict, map: "trip_dates_ibfk_1")

  @@index([trips_id], map: "trips_id")
}

model trip_images {
  id        Int    @id @default(autoincrement())
  trips_id  Int
  image_url String @db.VarChar(255)
  trips     trips  @relation(fields: [trips_id], references: [id], onUpdate: Restrict, map: "trip_images_ibfk_1")

  @@index([trips_id], map: "trips_id")
}

model trips {
  id              Int           @id @default(autoincrement())
  title           String        @db.VarChar(255)
  description     String        @db.Text
  price           Decimal       @db.Decimal(10, 2)
  duration        Int
  rating          Int?          @default(0)
  created_at      DateTime      @db.DateTime(0)
  countries_id    Int?
  travel_types_id Int?
  bookings        bookings[]
  includes        includes[]
  review          review[]
  trip_dates      trip_dates[]
  trip_images     trip_images[]
  uses            uses[]
}

model users {
  id            Int        @id @default(autoincrement())
  first_name    String     @db.VarChar(255)
  last_name     String     @db.VarChar(255)
  email         String     @unique(map: "email") @db.VarChar(255)
  phone         String     @unique(map: "phone") @db.VarChar(20)
  password      String     @db.VarChar(255)
  profile_image String?    @db.VarChar(255)
  created_at    DateTime   @db.DateTime(0)
  bookings      bookings[]
  review        review[]
}

model admin {
  id            Int        @id @default(autoincrement())
  first_name    String     @db.VarChar(255)
  last_name     String     @db.VarChar(255)
  email         String     @unique(map: "email") @db.VarChar(255)
  phone         String     @unique(map: "phone") @db.VarChar(20)
  password      String     @db.VarChar(255)
  profile_image String?    @db.VarChar(255)
  created_at    DateTime   @db.DateTime(0)
  
}

model uses {
  id         Int     @id @default(autoincrement())
  trips_id   Int
  flights_id Int
  trips      trips   @relation(fields: [trips_id], references: [id], onUpdate: Restrict, map: "uses_ibfk_1")
  flights    flights @relation(fields: [flights_id], references: [id], onUpdate: Restrict, map: "uses_ibfk_2")

  @@index([flights_id], map: "flights_id")
  @@index([trips_id], map: "trips_id")
}